-----Base class code

public class BaseClass {
	public propertyUtility pu=new PropertyUtility();
	public ExcelUtility eu=new ExcelUtility();
	public WebDriverUtility wu=new WebDriverUtility();
	public DatabaseUtility du=new DatabaseUtility();
	public WebDriver driver=null;
	public static WebDriver sdriver=null;
	public Connection c;
	
	@BeforeSuite
	public void configBS(){
		//connect to database
		du.getdBConnection(String url,String username,String password);
	}
	@BeforeClass
	public void configBC(){
		String browser=pu.readProperty("browser");
		driver=wu.launchBrowser(browser);
		sdriver=driver;
		wu.maximizeBrowser(driver);
		wu.implicitWait(driver);
		driver.get(pu.readProperty("url"));
	}
	@BeforeMethod
	public void configBM(){
		String userName=pu.readProperty("username");
		String password=pu.readProperty("password");
		Loginpage lp=new LoginPage(driver);
		lp.userLogin(userName,password);
	}
	@AfterMethod
	public void configAM(){
		HomePage hp=new HomePage(driver);
		Actions a=new Actions(driver);
		a.moveToElement(hp.getUserIcon()).pause(1000).click(hp.getSignOut()).build().perform();
	}
	@AfterClass
	public void configAC(){
		//close browser
		driver.quit();
	}
	@AfterSuite
	public void configAS(){
		//close database connection
		c.closeConnection();
	}
}
		
